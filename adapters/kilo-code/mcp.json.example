{
  "mcp": {
    "agent_intercom": {
      "type": "local",
      "command": [
        "{{command}}",
        "mcp",
        "stdio",
        "--scope",
        "{{scope}}",
        "--agent",
        "{{agent}}",
        "--name",
        "{{name}}",
        "--data-dir",
        "{{dataDir}}",
        "--runtime-dir",
        "{{runtimeDir}}"
      ],
      "enabled": true
    }
  }
}
