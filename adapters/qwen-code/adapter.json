{
  "schemaVersion": 1,
  "id": "qwen-code-mcp",
  "adapterVersion": "0.2.0",
  "harnessFamily": "Qwen Code",
  "status": "experimental",
  "protocolVersions": [
    "0.1"
  ],
  "transport": "mcp",
  "delivery": "pull",
  "lifecycleEvidence": "process",
  "capabilities": [
    "discovery",
    "messaging",
    "requests",
    "tasks",
    "escalation",
    "bounded-context"
  ],
  "testedVersions": [],
  "platforms": [],
  "maintainer": "October",
  "repository": "https://github.com/october-dev/october-bus",
  "limitations": [
    "Configuration reviewed against upstream documentation; this adapter revision has no named-harness certification",
    "Pull-only: queued work does not start a model turn",
    "One MCP configuration is one execution; duplicate agent IDs replace earlier executions"
  ],
  "conformanceCommand": "agentintercom-conformance --profile mcp-adapter --start-runtime --adapter-command agentintercom --adapter-arg mcp --adapter-arg stdio --check-self-registration",
  "configuration": {
    "file": "mcp.json.example",
    "format": "json",
    "location": ".qwen/settings.json",
    "executable": "qwen",
    "docs": "https://qwenlm.github.io/qwen-code-docs/en/users/features/mcp/",
    "recommendedWaitMs": 1000
  }
}
