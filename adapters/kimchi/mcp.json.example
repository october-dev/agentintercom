{
  "mcpServers": {
    "agent_intercom": {
      "command": "{{command}}",
      "args": [
        "mcp",
        "stdio",
        "--scope",
        "{{scope}}",
        "--agent",
        "{{agent}}",
        "--name",
        "{{name}}",
        "--data-dir",
        "{{dataDir}}",
        "--runtime-dir",
        "{{runtimeDir}}"
      ],
      "directTools": true,
      "lifecycle": "eager"
    }
  }
}
