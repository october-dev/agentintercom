{
  "schemaVersion": 1,
  "id": "omp-mcp",
  "adapterVersion": "0.2.0",
  "harnessFamily": "OMP (oh-my-pi)",
  "status": "experimental",
  "protocolVersions": [
    "0.1"
  ],
  "transport": "mcp",
  "delivery": "pull",
  "lifecycleEvidence": "process",
  "capabilities": [
    "discovery",
    "messaging",
    "requests",
    "tasks",
    "escalation",
    "bounded-context"
  ],
  "testedVersions": [],
  "platforms": [],
  "maintainer": "October",
  "repository": "https://github.com/october-dev/agent-intercom",
  "limitations": [
    "Experimental configuration, not named-harness certification.",
    "OMP can discover other hosts’ configurations; disable duplicate Agent Intercom entries to avoid replacing your own execution. The intended identity is can1357/oh-my-pi; confirm this matches issue #42."
  ],
  "conformanceCommand": "agentintercom-conformance --profile mcp-adapter --start-runtime --adapter-command agentintercom --adapter-arg mcp --adapter-arg stdio --check-self-registration",
  "configuration": {
    "file": "mcp.json.example",
    "format": "json",
    "location": ".omp/mcp.json",
    "docs": "https://github.com/can1357/oh-my-pi/blob/main/docs/mcp-config.md",
    "recommendedWaitMs": 10000,
    "executable": "omp"
  }
}
