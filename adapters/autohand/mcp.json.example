{
  "mcp": {
    "servers": [
      {
        "name": "agent_intercom",
        "transport": "stdio",
        "command": "{{command}}",
        "args": [
          "mcp",
          "stdio",
          "--scope",
          "{{scope}}",
          "--agent",
          "{{agent}}",
          "--name",
          "{{name}}",
          "--data-dir",
          "{{dataDir}}",
          "--runtime-dir",
          "{{runtimeDir}}"
        ],
        "autoConnect": true
      }
    ]
  }
}
