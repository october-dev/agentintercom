{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/october-dev/agent-intercom/spec/0.1/schemas/compatibility-evidence.schema.json",
  "title": "Agent Intercom compatibility evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "harnessFamily",
    "harnessVersion",
    "adapterId",
    "adapterVersion",
    "protocolVersion",
    "runtimeVersion",
    "operatingSystem",
    "architecture",
    "profile",
    "result",
    "resultDigest",
    "verifiedAt",
    "repositoryCommit",
    "verificationMode",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "harnessFamily": { "type": "string", "minLength": 1 },
    "harnessVersion": { "type": "string", "minLength": 1 },
    "launchMode": { "type": "string", "minLength": 1, "maxLength": 256 },
    "model": { "type": "string", "minLength": 1, "maxLength": 256 },
    "adapterId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "adapterVersion": { "type": "string", "minLength": 1 },
    "protocolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "runtimeVersion": { "type": "string", "minLength": 1 },
    "operatingSystem": { "type": "string", "enum": ["macos", "linux", "windows"] },
    "architecture": { "type": "string", "enum": ["amd64", "arm64"] },
    "profile": { "type": "string", "enum": ["local-runtime", "mcp-adapter", "native-adapter"] },
    "result": { "type": "string", "enum": ["passed", "failed"] },
    "resultDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "repositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "verificationMode": { "type": "string", "enum": ["automated", "assisted", "manual"] },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "attestation": { "type": "string", "format": "uri" }
  }
}
