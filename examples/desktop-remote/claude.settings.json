{
  "hooks": {
    "SessionStart": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "\"/home/worker/.october/servers/<install>/current/bin/agentintercom\" hook session-start", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "\"/home/worker/.october/servers/<install>/current/bin/agentintercom\" hook pre-prompt", "timeout": 5 }] }],
    "Stop": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "\"/home/worker/.october/servers/<install>/current/bin/agentintercom\" hook stop", "timeout": 5 }] }],
    "StopFailure": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "\"/home/worker/.october/servers/<install>/current/bin/agentintercom\" hook stop-failure", "timeout": 5 }] }],
    "SessionEnd": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "\"/home/worker/.october/servers/<install>/current/bin/agentintercom\" hook session-end", "timeout": 5 }] }],
    "Notification": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "\"/home/worker/.october/servers/<install>/current/bin/agentintercom\" hook notify", "timeout": 5 }] }],
    "PermissionRequest": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "\"/home/worker/.october/servers/<install>/current/bin/agentintercom\" hook permission-request", "timeout": 5 }] }],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "\"/home/worker/.october/servers/<install>/current/bin/agentintercom\" hook post-tool-use", "timeout": 5 }] },
      { "matcher": "AskUserQuestion|ExitPlanMode", "hooks": [{ "type": "command", "command": "\"/home/worker/.october/servers/<install>/current/bin/agentintercom\" hook ask-user-question-resolved", "timeout": 5 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "\"/home/worker/.october/servers/<install>/current/bin/agentintercom\" hook post-tool-use-failure", "timeout": 5 }] },
      { "matcher": "AskUserQuestion|ExitPlanMode", "hooks": [{ "type": "command", "command": "\"/home/worker/.october/servers/<install>/current/bin/agentintercom\" hook ask-user-question-resolved", "timeout": 5 }] }
    ],
    "PreToolUse": [{ "matcher": "AskUserQuestion|ExitPlanMode", "hooks": [{ "type": "command", "command": "\"/home/worker/.october/servers/<install>/current/bin/agentintercom\" hook ask-user-question", "timeout": 5 }] }]
  },
  "permissions": { "allow": ["mcp__agentintercom__*"] }
}
