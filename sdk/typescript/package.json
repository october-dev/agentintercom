{
  "name": "@october-dev/october-bus",
  "version": "0.1.0-next.15",
  "description": "October Bus native CLI and TypeScript client for agent coordination.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "October",
  "homepage": "https://github.com/october-dev/october-bus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/october-dev/october-bus.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/october-dev/october-bus/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai-agents",
    "agent-communication",
    "coordination",
    "mcp",
    "multi-agent"
  ],
  "main": "./dist/index.js",
  "bin": {
    "october-bus": "cli/october-bus.cjs"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    }
  },
  "files": [
    "cli/*.cjs",
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "src/*.ts",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "node -e \"throw new Error('Publish the staged distribution through publish-npm-prerelease.yml, not this source directory')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:errors": "node test/errors.mjs && node --test test/sessions.mjs test/cli.mjs",
    "test:integration": "node test/integration.mjs",
    "test:ready-edge": "node test/session-ready-edge.mjs",
    "test:release": "node ../../scripts/validate-launch.mjs --scripts-only",
    "validate:launch": "node ../../scripts/validate-launch.mjs",
    "build:native": "node ../../scripts/npm-distribution.mjs build",
    "pack:distribution": "node ../../scripts/npm-distribution.mjs pack",
    "test:distribution": "node ../../scripts/test-npm-install.mjs",
    "publish:distribution": "node ../../scripts/publish-npm.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
